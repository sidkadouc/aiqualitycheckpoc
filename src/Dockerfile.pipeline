# ───────────────────────────────────────────────────────────────
# Dockerfile — PDF Policy Extraction Pipeline
# Deploy to Azure Container Apps (job or on-demand container)
# ───────────────────────────────────────────────────────────────
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies (poppler for PDF, gcc for native deps)
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc poppler-utils && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy application source
COPY pdf_pipeline/ ./pdf_pipeline/
COPY run_pipeline.py .

# Output directory for intermediate files
RUN mkdir -p /app/pipeline_output
ENV PIPELINE_OUTPUT_DIR=/app/pipeline_output

# Expose port 8080 for optional health endpoint / triggering via HTTP
EXPOSE 8080

# Default: run the pipeline (expects PDF_PATH env var or mounted volume)
# Override CMD when deploying as a Container App Job
CMD ["python", "run_pipeline.py", "--output-dir", "/app/pipeline_output", "${PDF_PATH:-/data/input.pdf}"]
