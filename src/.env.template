# Variables d'environnement pour la pipeline PDF
# Copier ce fichier en .env et remplir les valeurs

# === Azure AI Foundry / OpenAI ===
AZURE_OPENAI_ENDPOINT=https://aoai-<env>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_GPT41_DEPLOYMENT=gpt-4.1

AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large


# Azure OpenAI fallback (GPT-4.1)
AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_FALLBACK_TPM=256000
AZURE_OPENAI_FALLBACK_CONCURRENCY=3

# === Azure Document Intelligence ===
# Utilise le même endpoint AI Services (Content Understanding)
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://aoai-<env>.services.ai.azure.com
AZURE_DOC_INTELLIGENCE_KEY=

# === Azure AI Search ===
AZURE_AISEARCH_ENDPOINT=https://srch-<env>.search.windows.net
AZURE_AISEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=policy-chunks

# === Azure Cosmos DB ===
AZURE_COSMOS_ENDPOINT=https://cosmos-<env>-001.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=appdata
AZURE_COSMOS_RULES_CONTAINER=policy-rules

# === Rules source ===
# false (default) = load rules from local JSON file (RULES_JSON_PATH)
# true = load rules from Cosmos DB at startup
USE_COSMOS_RULES=false

# === Azure Storage ===
AZURE_STORAGE_CONNECTION_STRING=

# === Authentication (production: use managed identity) ===
USE_MANAGED_IDENTITY=false

# === Rule extraction mode ===
# false (default) = deterministic, no LLM call, instant, 0 $
# true = LLM-based (GPT-4.1), richer but ~2-5 $ per 150 pages
USE_LLM_EXTRACTION=false
