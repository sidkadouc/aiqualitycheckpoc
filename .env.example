# ═══════════════════════════════════════════════════════════════════
# OECD Quality Checker — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# The deploy-all.ps1 script reads these variables.
# ═══════════════════════════════════════════════════════════════════

# ── Azure basics ──────────────────────────────────────────────────
AZURE_ENV_NAME=oecdquality-dev
AZURE_LOCATION=francecentral
AZURE_SUBSCRIPTION_ID=
AZURE_ENV_TYPE=dev
APPLICATION_NAME=oecd-quality

# ── Secrets (optional — auto-generated by Bicep if left empty) ───
AZURE_OPENAI_KEY=
AZURE_AISEARCH_SECRET=
API_KEY=
SERVICE_API_KEY=
JWT_KEY=

# ── Email / ACS (leave empty if not needed) ──────────────────────
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
ACS_CONNECTION_STRING=

# ── Cosmos DB ─────────────────────────────────────────────────────
COSMOS_DB_DATABASE_NAME=appdata
AZURE_COSMOS_RULES_CONTAINER=policy-rules

# ── SQL (leave empty to skip) ────────────────────────────────────
SQL_DATABASE_NAME=AppDb
AZURE_PRINCIPAL_ID=
AZURE_PRINCIPAL_LOGIN=

# ── Container images (tags used during Docker build & push) ──────
IMAGE_TAG=latest
